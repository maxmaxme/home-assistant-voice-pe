{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard", ":semanticCommits", ":timezone(Europe/Madrid)"],
  "forkProcessing": "enabled",
  "schedule": ["* 6-10 * * 1"],
  "prHourlyLimit": 4,
  "prConcurrentLimit": 8,
  "minimumReleaseAge": "3 days",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep the pinned ESPHome version in lockstep across the CI compile pin, the upstream build workflow input, and every firmware config's min_version",
      "managerFilePatterns": [
        "/^\\.github/workflows/build-va-direct\\.yml$/",
        "/^\\.github/workflows/build\\.yml$/",
        "/\\.yaml$/"
      ],
      "matchStrings": [
        "esphome==(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "ESPHOME_VERSION:\\s*\"?(?<currentValue>\\d+\\.\\d+\\.\\d+)\"?",
        "esphome-version:\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "min_version:\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "pypi",
      "depNameTemplate": "esphome"
    }
  ],
  "packageRules": [
    {
      "description": "Minor/patch/digest bumps ride one weekly PR and merge themselves once CI is green",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "non-major dependencies",
      "automerge": true
    },
    {
      "description": "Majors wait for a tick in the Dependency Dashboard",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "One grouped PR for every ESPHome pin so CI/build/min_version never drift apart; firmware bumps are merged by hand",
      "matchDatasources": ["pypi"],
      "matchDepNames": ["esphome"],
      "groupName": "esphome",
      "automerge": false
    }
  ]
}
